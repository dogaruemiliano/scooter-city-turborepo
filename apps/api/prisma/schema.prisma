// Auth, fleet, and financial subsystem schema.
//
// Design references:
// - docs/adr/0002-cookie-based-sessions.md         (cookies, no authjs)
// - docs/adr/0003-multi-instance-refresh-rotation.md (previous_jti + pendingTokenHash)
// - docs/auth/sessions-and-audit.md                 (this PR — what each table is for)
//
// Account deletion is a soft-delete of User plus explicit removal of
// authentication-owned records. Person uses `Restrict` as a database-level
// guard against accidental hard deletion. Audit and financial records remain
// linked to the preserved User row.

// Canonical Prisma 7 generator block. See AGENTS.md → prisma-verify-rule.
// - `prisma-client` (not the deprecated `prisma-client-js`)
// - `engineType = "client"` (WASM compiler, no Rust binary)
// - `output` is required in v7 and lives outside node_modules; consumers
//   import from `../src/generated/prisma/client` rather than `@prisma/client`.
generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  engineType      = "client"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

// The `url` lives in `prisma.config.ts` from Prisma 7 onward. Migrate +
// generate commands read it from there; the runtime PrismaClient (later
// PR) gets it via the PrismaPg driver adapter.
datasource db {
  provider = "postgresql"
}

enum WalletType {
  USER
  COMPANY_CASH
  COMPANY_BANK
  PAYMENT_PROCESSOR
}

enum WalletBalanceBucket {
  USER_SETTLEMENT
  BUSINESS_FUNDS
  ADMIN_PERSONAL_FUNDS
  CUSTOMER_GUARANTEE_FUNDS
}

enum MoneyTransactionType {
  INCOME
  EXPENSE
  TRANSFER
  USER_CHARGE
  USER_PAYMENT
  GUARANTEE_RECEIVED
  GUARANTEE_REFUNDED
  REIMBURSEMENT
  PERSONAL_EXTRACTION
  PERSONAL_FUNDS_SPLIT
  PERSONAL_FUNDS_CLAIM
  COMPANY_DISTRIBUTION
  REFUND
  ADJUSTMENT
  REVERSAL
}

enum MoneyTransactionStatus {
  DRAFT
  POSTED
  REVERSED
}

enum MoneyTransactionScope {
  COMPANY
  ADMIN_PERSONAL
  CUSTOMER_HELD
}

enum PaymentMethod {
  CASH
  POS
  BANK_TRANSFER
  ONLINE_PAYMENT
}

enum BillingStatus {
  BILLED
  NOT_BILLED
  NOT_APPLICABLE
}

enum FinancialCategoryKind {
  INCOME
  EXPENSE
  BOTH
}

/// Admin-managed person record used by rental flows.
///
/// `Person` remains separate from authentication details, but every person is
/// backed by exactly one User. Person creation must create both records in one
/// database transaction.
model Person {
  id           String           @id @default(cuid())
  userId       String           @unique
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  email        String           @unique
  phone        String           @unique
  firstName    String
  lastName     String
  dateOfBirth  DateTime?        @db.Date
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  countryCode  String?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?
  documents    PersonDocument[]

  @@index([deletedAt])
  @@index([lastName, firstName])
  @@index([countryCode, deletedAt])
}

/// KYC/rental document belonging to a Person.
///
/// A person can hold multiple documents at once, for example a Romanian
/// national ID (`type = "nationalId"`, `issuingCountryCode = "RO"`) and a
/// driver license. Document photos are stored as private MediaAsset rows.
model PersonDocument {
  id                 String                @id @default(cuid())
  personId           String
  person             Person                @relation(fields: [personId], references: [id], onDelete: Cascade)
  type               String
  series             String?
  number             String?
  cnp                String?
  issuingCountryCode String?
  issuedBy           String?
  issuedOn           DateTime?             @db.Date
  expiresOn          DateTime?             @db.Date
  status             String                @default("unverified")
  notes              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?
  photos             PersonDocumentPhoto[]

  @@unique([personId, type], map: "person_document_active_type_unique", where: { deletedAt: null })
  @@unique([personId], map: "person_document_active_identity_unique", where: raw("\"deletedAt\" IS NULL AND \"type\" IN ('passport', 'nationalId', 'residencePermit', 'other')"))
  @@index([personId, deletedAt])
  @@index([personId, type, status, issuingCountryCode, expiresOn], map: "PersonDocument_active_filters_idx", where: { deletedAt: null })
  @@index([type])
  @@index([status])
  @@index([expiresOn])
}

/// A human. `emailVerified` / `phoneVerified` are timestamps (not
/// booleans) — when verified is the audit trail.
///
/// Email-and-password login isn't part of the v1 template — every auth
/// method here proves identity via a channel (OTP) or an OAuth provider.
/// If a future variant needs password login, add `passwordHash` back via
/// migration; nothing else has to move.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  phone         String?   @unique
  phoneVerified DateTime?
  firstName     String?
  lastName      String?
  /// Authorization roles. Snapshotted into access-JWT claims at issue
  /// time; downstream services read `request.user.roles`. Re-read the
  /// DB for fresh values; the JWT can lag by up to JWT_ACCESS_TTL.
  roles         String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  /// Account deactivation marker. DELETE /v1/auth/me sets this value while
  /// preserving the User row and its business history.
  deletedAt     DateTime?

  sessions                   Session[]
  refreshTokens              RefreshToken[]
  otpChallenges              OtpChallenge[]
  authAccounts               AuthAccount[]
  auditEvents                AuditEvent[]
  mediaAssets                MediaAsset[]
  draftUploads               DraftUpload[]
  person                     Person?
  wallet                     Wallet?            @relation("WalletOwner")
  transactionsRecorded       MoneyTransaction[] @relation("MoneyTransactionRecordedBy")
  transactionsAsCounterparty MoneyTransaction[] @relation("MoneyTransactionCounterparty")
  transactionsAsRecipient    MoneyTransaction[] @relation("MoneyTransactionRecipient")
  transactionsAsDebtor       MoneyTransaction[] @relation("MoneyTransactionDebtor")
  transactionsAsCreditor     MoneyTransaction[] @relation("MoneyTransactionCreditor")

  @@index([email])
  @@index([phone])
}

/// A tracked money location or a user's single financial wallet.
///
/// USER wallets have an owner. Company cash, bank, and payment-processor
/// wallets do not. The unique ownerUserId enforces at most one wallet per user;
/// user creation is responsible for creating it.
model Wallet {
  id          String     @id @default(cuid())
  type        WalletType
  ownerUserId String?    @unique
  owner       User?      @relation("WalletOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  name        String
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  balances       WalletBalance[]
  balanceChanges WalletBalanceChange[]

  @@index([type, isActive])
}

/// Fast, rebuildable current balance for one wallet, bucket, and currency.
///
/// USER_SETTLEMENT is from the user's perspective: positive means the company
/// owes the user; negative means the user owes the company.
model WalletBalance {
  id        String              @id @default(cuid())
  walletId  String
  wallet    Wallet              @relation(fields: [walletId], references: [id], onDelete: Restrict)
  bucket    WalletBalanceBucket
  currency  String              @default("RON") @db.Char(3)
  balance   Decimal             @default(0) @db.Decimal(19, 2)
  updatedAt DateTime            @updatedAt

  @@unique([walletId, bucket, currency])
  @@index([bucket, currency])
}

/// User-facing financial event describing why money or an obligation changed.
///
/// Only POSTED transactions affect WalletBalance. Posted rows are immutable;
/// corrections are represented by a new REVERSAL transaction.
model MoneyTransaction {
  id                      String                 @id @default(cuid())
  type                    MoneyTransactionType
  status                  MoneyTransactionStatus @default(DRAFT)
  amount                  Decimal                @db.Decimal(19, 2)
  currency                String                 @default("RON") @db.Char(3)
  financialScope          MoneyTransactionScope
  paymentMethod           PaymentMethod?
  billingStatus           BillingStatus          @default(NOT_APPLICABLE)
  categoryId              String?
  category                FinancialCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  counterpartyUserId      String?
  counterparty            User?                  @relation("MoneyTransactionCounterparty", fields: [counterpartyUserId], references: [id], onDelete: SetNull)
  recipientUserId         String?
  recipient               User?                  @relation("MoneyTransactionRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  debtorUserId            String?
  debtor                  User?                  @relation("MoneyTransactionDebtor", fields: [debtorUserId], references: [id], onDelete: SetNull)
  creditorUserId          String?
  creditor                User?                  @relation("MoneyTransactionCreditor", fields: [creditorUserId], references: [id], onDelete: SetNull)
  recordedByUserId        String?
  recordedBy              User?                  @relation("MoneyTransactionRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  occurredAt              DateTime
  description             String?
  idempotencyKey          String                 @unique
  /// Source event that automatically generated this transaction. A
  /// PERSONAL_FUNDS_CLAIM points to the ADMIN_PERSONAL income that created it.
  originTransactionId     String?
  originTransaction       MoneyTransaction?      @relation("MoneyTransactionOrigin", fields: [originTransactionId], references: [id], onDelete: Restrict)
  generatedTransactions   MoneyTransaction[]     @relation("MoneyTransactionOrigin")
  reversalOfTransactionId String?
  reversalOf              MoneyTransaction?      @relation("MoneyTransactionReversal", fields: [reversalOfTransactionId], references: [id], onDelete: Restrict)
  reversals               MoneyTransaction[]     @relation("MoneyTransactionReversal")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  balanceChanges WalletBalanceChange[]
  references     MoneyTransactionReference[]

  @@index([status, occurredAt])
  @@index([financialScope, billingStatus, occurredAt])
  @@index([paymentMethod, occurredAt])
  @@index([categoryId, occurredAt])
  @@index([counterpartyUserId, occurredAt])
  @@index([recipientUserId, occurredAt])
  @@index([debtorUserId, creditorUserId, occurredAt])
  @@index([recordedByUserId, occurredAt])
  @@index([originTransactionId])
  @@index([reversalOfTransactionId])
}

/// Exact signed balance effect produced by a MoneyTransaction.
///
/// A collection or extraction can have one row, a transfer has two rows, and
/// events such as guarantees can affect both a money location and a user's
/// settlement balance without duplicating the parent transaction.
model WalletBalanceChange {
  id                 String              @id @default(cuid())
  moneyTransactionId String
  moneyTransaction   MoneyTransaction    @relation(fields: [moneyTransactionId], references: [id], onDelete: Restrict)
  walletId           String
  wallet             Wallet              @relation(fields: [walletId], references: [id], onDelete: Restrict)
  bucket             WalletBalanceBucket
  currency           String              @default("RON") @db.Char(3)
  amountDelta        Decimal             @db.Decimal(19, 2)
  createdAt          DateTime            @default(now())

  @@unique([moneyTransactionId, walletId, bucket, currency])
  @@index([walletId, bucket, currency, createdAt])
}

/// Configurable reporting category. Categories are data rather than enums so
/// the business can add scooter and company categories without a migration.
model FinancialCategory {
  id               String                @id @default(cuid())
  code             String                @unique
  name             String
  kind             FinancialCategoryKind
  parentCategoryId String?
  parentCategory   FinancialCategory?    @relation("FinancialCategoryTree", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children         FinancialCategory[]   @relation("FinancialCategoryTree")
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  transactions MoneyTransaction[]

  @@index([parentCategoryId])
  @@index([kind, isActive])
}

/// Polymorphic link from a financial event to its source domain records.
///
/// Prisma does not model polymorphic foreign keys, so referenceType and
/// referenceId are validated by the financial application service.
model MoneyTransactionReference {
  id                 String           @id @default(cuid())
  moneyTransactionId String
  moneyTransaction   MoneyTransaction @relation(fields: [moneyTransactionId], references: [id], onDelete: Restrict)
  referenceType      String
  referenceId        String
  isPrimary          Boolean          @default(false)
  createdAt          DateTime         @default(now())

  @@unique([moneyTransactionId, referenceType, referenceId])
  @@index([referenceType, referenceId])
  @@index([moneyTransactionId, isPrimary])
}

/// Private media object metadata.
///
/// The object bytes live in the configured private S3 bucket. This table keeps
/// the server-only storage key and public-safe metadata that API responses can
/// expose through domain-specific resources such as PersonDocumentPhoto.
model MediaAsset {
  id               String                @id @default(cuid())
  provider         String
  bucket           String
  storageKey       String                @unique
  contentType      String
  byteSize         Int
  checksumSha256   String
  uploadedByUserId String?
  uploadedByUser   User?                 @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now())
  deletedAt        DateTime?
  documentPhotos   PersonDocumentPhoto[]

  @@index([provider, bucket])
  @@index([uploadedByUserId])
  @@index([deletedAt])
}

/// Browser-uploaded object that is not attached to a domain record yet.
///
/// Person creation uses this for direct-to-S3 document photos: the API creates
/// a row and signed PUT URL, the browser uploads the bytes to S3, and final
/// submit claims the row into MediaAsset / PersonDocumentPhoto. Expired,
/// unclaimed rows identify S3 objects that can be cleaned up as abandoned
/// drafts.
model DraftUpload {
  id             String    @id @default(cuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider       String
  bucket         String
  storageKey     String    @unique
  contentType    String
  byteSize       Int
  checksumSha256 String
  purpose        String
  expiresAt      DateTime
  claimedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, purpose, claimedAt, expiresAt])
  @@index([claimedAt, expiresAt])
  @@index([purpose, expiresAt])
}

/// Photo attached to one person document slot.
///
/// A partial unique index allows exactly one active image per document and
/// slot while preserving replaced/deleted history.
model PersonDocumentPhoto {
  id               String         @id @default(cuid())
  personDocumentId String
  personDocument   PersonDocument @relation(fields: [personDocumentId], references: [id], onDelete: Cascade)
  assetId          String         @unique
  asset            MediaAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  slot             String
  createdAt        DateTime       @default(now())
  deletedAt        DateTime?

  @@unique([personDocumentId, slot], map: "person_document_photo_active_slot_unique", where: { deletedAt: null })
  @@index([personDocumentId, deletedAt])
  @@index([slot])
}

/// Scooter inventory record with Romanian registration metadata.
model Scooter {
  id                        String    @id @default(cuid())
  vin                       String    @unique
  brand                     String
  model                     String
  color                     String?
  manufactureYear           Int
  powertrainType            String
  engineCc                  Int?
  powerKw                   Float?
  purchasedOn               DateTime  @db.Date
  registrationType          String    @default("unregistered")
  plateNumber               String?
  plateNumberNormalized     String?
  registeredOn              DateTime? @db.Date
  registrationExpiresOn     DateTime? @db.Date
  requiredDriverLicenseType String    @default("none")
  notes                     String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime?

  @@unique([plateNumberNormalized], map: "Scooter_active_plateNumberNormalized_key", where: raw("\"deletedAt\" IS NULL AND \"plateNumberNormalized\" IS NOT NULL"))
  @@index([deletedAt])
  @@index([powertrainType, deletedAt])
  @@index([registrationType, deletedAt])
  @@index([requiredDriverLicenseType, deletedAt])
  @@index([brand, model])
  @@index([purchasedOn])
}

/// First-class session record. One row per "logged-in device". Refresh-token
/// rotations within the same session reuse this row (only `lastUsedAt`
/// moves). Powers the user-visible "active devices" list and "log out other
/// devices" UI.
model Session {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent     String?
  ip            String?
  createdAt     DateTime       @default(now())
  lastUsedAt    DateTime       @default(now())
  revokedAt     DateTime?
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
}

/// One row per refresh-token *value* ever minted. Multiple rows per session
/// (one per rotation). The cleanup cron deletes rows older than `expiresAt`.
///
/// - `tokenHash` is the SHA-256 HMAC of the plaintext token (peppered by
///   REFRESH_TOKEN_HMAC_SECRET). Stored, not the plaintext.
/// - `previousJti` chains a row to the row it replaced. Lets concurrent
///   refreshes within the grace window detect they're racing against an
///   already-rotated token without rejecting either caller.
/// - `pendingTokenHash` is reserved for a possible future literal
///   idempotency design. The current chain algorithm does not use it.
/// - `revokedAt` is set on rotation, on logout, and on full-session burn
///   (reuse detection).
model RefreshToken {
  id               String    @id @default(cuid())
  jti              String    @unique
  previousJti      String?   @unique
  pendingTokenHash String?
  sessionId        String
  session          Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([sessionId, revokedAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

/// One active proof per logical target. `activeKey` is cleared when the
/// challenge is consumed or superseded, allowing historical rows to remain
/// without blocking a new issuance.
///
/// The plaintext code is derived from this UUID and OTP_HMAC_SECRET, then only
/// its HMAC is persisted. Resends therefore deliver the same code without
/// storing recoverable plaintext.
model OtpChallenge {
  id            String    @id @default(uuid()) @db.Uuid
  activeKey     String?   @unique
  /// Currently "EMAIL"; reserved for future channel verification.
  channel       String
  /// "AUTH" | "OAUTH_EMAIL_VERIFY"
  purpose       String
  /// Normalized email or phone target.
  target        String
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// OAuth context is populated only for OAUTH_EMAIL_VERIFY.
  provider      String?
  providerId    String?
  firstName     String?
  lastName      String?
  codeHash      String
  expiresAt     DateTime
  usedAt        DateTime?
  attemptsCount Int       @default(0)
  sentCount     Int       @default(1)
  lastSentAt    DateTime  @default(now())
  nextSendAt    DateTime
  createdAt     DateTime  @default(now())

  @@index([channel, purpose, target, usedAt, expiresAt])
  @@index([provider, providerId, purpose, usedAt, expiresAt])
  @@index([userId])
  @@index([expiresAt])
}

/// Fixed-window counters for successful OTP delivery attempts.
///
/// `subjectHash` is an HMAC-derived target or IP identifier. No additional
/// plaintext email or IP data is stored here. Rows are independent of
/// challenges so limits survive challenge expiry, API restarts, and
/// multi-instance deployments.
model OtpDeliveryQuota {
  /// "TARGET_HOUR" | "TARGET_DAY" | "IP_HOUR"
  bucket      String
  subjectHash String
  windowStart DateTime
  windowEnd   DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([bucket, subjectHash, windowStart])
  @@index([windowEnd])
}

/// One row per OAuth identity linked to a user. The `provider + providerId`
/// uniqueness prevents the same provider account from binding to two users.
///
/// `email` is captured opportunistically at link time for support and audit
/// context. Repeat logins resolve through the stable provider subject, so
/// providers may omit the email claim after the initial link.
model AuthAccount {
  id         String   @id @default(cuid())
  /// "google" | "apple"
  provider   String
  providerId String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String?
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@index([userId])
}

/// Append-only audit log. Account deactivation preserves both the row and its
/// User relation so forensics + compliance reports retain their actor context.
///
/// `type` values are defined in TS by `AuditEventType` and include:
/// SIGNUP, LOGIN_SUCCESS, LOGIN_FAIL, EMAIL_VERIFIED, OAUTH_LINKED,
/// OAUTH_UNLINKED, SESSION_REVOKED, SESSION_BURNED, LOGOUT_ALL,
/// ACCOUNT_DELETED, NEW_DEVICE_NOTIFIED.
model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type       String
  targetType String?
  targetId   String?
  ip         String?
  userAgent  String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([userId, type, createdAt])
  @@index([type, createdAt])
  @@index([targetType, targetId, createdAt])
}
