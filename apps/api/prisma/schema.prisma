// Auth and fleet schema.
//
// Design references:
// - docs/adr/0002-cookie-based-sessions.md         (cookies, no authjs)
// - docs/adr/0003-multi-instance-refresh-rotation.md (previous_jti + pendingTokenHash)
// - docs/auth/sessions-and-audit.md                 (this PR — what each table is for)
//
// Account deletion is a soft-delete of User plus explicit removal of
// authentication-owned records. Person uses `Restrict` as a database-level
// guard against accidental hard deletion. Audit records remain linked to the
// preserved User row.

// Canonical Prisma 7 generator block. See AGENTS.md → prisma-verify-rule.
// - `prisma-client` (not the deprecated `prisma-client-js`)
// - `engineType = "client"` (WASM compiler, no Rust binary)
// - `output` is required in v7 and lives outside node_modules; consumers
//   import from `../src/generated/prisma/client` rather than `@prisma/client`.
generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  engineType      = "client"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

// The `url` lives in `prisma.config.ts` from Prisma 7 onward. Migrate +
// generate commands read it from there; the runtime PrismaClient (later
// PR) gets it via the PrismaPg driver adapter.
datasource db {
  provider = "postgresql"
}

enum ScooterIssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ScooterIssueStatus {
  OPEN
  FIXED
}

/// Admin-managed person record used by rental flows.
///
/// `Person` remains separate from authentication details, but every person is
/// backed by exactly one User. Person creation must create both records in one
/// database transaction.
model Person {
  id           String           @id @default(cuid())
  userId       String           @unique
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  email        String           @unique
  phone        String           @unique
  firstName    String
  lastName     String
  dateOfBirth  DateTime?        @db.Date
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  countryCode  String?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?
  documents    PersonDocument[]

  @@index([deletedAt])
  @@index([lastName, firstName])
  @@index([countryCode, deletedAt])
}

/// KYC/rental document belonging to a Person.
///
/// A person can hold multiple documents at once, for example a Romanian
/// national ID (`type = "nationalId"`, `issuingCountryCode = "RO"`) and a
/// driver license. Document photos are stored as private MediaAsset rows.
model PersonDocument {
  id                 String                @id @default(cuid())
  personId           String
  person             Person                @relation(fields: [personId], references: [id], onDelete: Cascade)
  type               String
  series             String?
  number             String?
  cnp                String?
  issuingCountryCode String?
  issuedBy           String?
  issuedOn           DateTime?             @db.Date
  expiresOn          DateTime?             @db.Date
  status             String                @default("unverified")
  notes              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?
  photos             PersonDocumentPhoto[]

  @@unique([personId, type], map: "person_document_active_type_unique", where: { deletedAt: null })
  @@unique([personId], map: "person_document_active_identity_unique", where: raw("\"deletedAt\" IS NULL AND \"type\" IN ('passport', 'nationalId', 'residencePermit', 'other')"))
  @@index([personId, deletedAt])
  @@index([personId, type, status, issuingCountryCode, expiresOn], map: "PersonDocument_active_filters_idx", where: { deletedAt: null })
  @@index([type])
  @@index([status])
  @@index([expiresOn])
}

/// A human. `emailVerified` / `phoneVerified` are timestamps (not
/// booleans) — when verified is the audit trail.
///
/// Email-and-password login isn't part of the v1 template — every auth
/// method here proves identity via a channel (OTP) or an OAuth provider.
/// If a future variant needs password login, add `passwordHash` back via
/// migration; nothing else has to move.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  phone         String?   @unique
  phoneVerified DateTime?
  firstName     String?
  lastName      String?
  /// Authorization roles. Snapshotted into access-JWT claims at issue
  /// time; downstream services read `request.user.roles`. Re-read the
  /// DB for fresh values; the JWT can lag by up to JWT_ACCESS_TTL.
  roles         String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  /// Account deactivation marker. DELETE /v1/auth/me sets this value while
  /// preserving the User row and its business history.
  deletedAt     DateTime?

  sessions                   Session[]
  refreshTokens              RefreshToken[]
  otpChallenges              OtpChallenge[]
  authAccounts               AuthAccount[]
  auditEvents                AuditEvent[]
  mediaAssets                MediaAsset[]
  draftUploads               DraftUpload[]
  person                     Person?
  scooterIssuesReported      ScooterIssue[]      @relation("ScooterIssueReportedBy")
  maintenanceRecordsRecorded MaintenanceRecord[] @relation("MaintenanceRecordRecordedBy")

  // Finance module. A User acting inside a finance book is an "associate";
  // there is deliberately no separate Associate table (see
  // docs/finance/financial-system-architecture.md §5).
  financeBookMemberships     FinanceBookMember[]       @relation("FinanceBookMemberAssociate")
  ledgerAccounts             LedgerAccount[]           @relation("LedgerAccountAssociate")
  financialOperationsCreated FinancialOperation[]      @relation("FinancialOperationCreatedBy")
  costObjectsOwned           CostObject[]              @relation("CostObjectOwner")
  costObjectsBenefiting      CostObject[]              @relation("CostObjectDefaultBeneficiary")
  expensePaymentsFunded      ExpensePayment[]          @relation("ExpensePaymentPayer")
  economicAllocations        EconomicAllocation[]      @relation("EconomicAllocationAssociate")
  associateFundings          AssociateFunding[]        @relation("AssociateFundingAssociate")
  reimbursements             Reimbursement[]           @relation("ReimbursementAssociate")
  personalUses               PersonalUse[]             @relation("PersonalUseAssociate")
  settlementRunsCreated      SettlementRun[]           @relation("SettlementRunCreatedBy")
  settlementShareSnapshots   SettlementShareSnapshot[] @relation("SettlementShareAssociate")
  settlementLines            SettlementLine[]          @relation("SettlementLineAssociate")
  settlementTransfersOut     SettlementTransfer[]      @relation("SettlementTransferFrom")
  settlementTransfersIn      SettlementTransfer[]      @relation("SettlementTransferTo")

  @@index([email])
  @@index([phone])
}

/// Private media object metadata.
///
/// The object bytes live in the configured private S3 bucket. This table keeps
/// the server-only storage key and public-safe metadata that API responses can
/// expose through domain-specific resources such as PersonDocumentPhoto.
model MediaAsset {
  id               String                @id @default(cuid())
  provider         String
  bucket           String
  storageKey       String                @unique
  contentType      String
  byteSize         Int
  checksumSha256   String
  uploadedByUserId String?
  uploadedByUser   User?                 @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now())
  deletedAt        DateTime?
  documentPhotos   PersonDocumentPhoto[]

  @@index([provider, bucket])
  @@index([uploadedByUserId])
  @@index([deletedAt])
}

/// Browser-uploaded object that is not attached to a domain record yet.
///
/// Person creation uses this for direct-to-S3 document photos: the API creates
/// a row and signed PUT URL, the browser uploads the bytes to S3, and final
/// submit claims the row into MediaAsset / PersonDocumentPhoto. Expired,
/// unclaimed rows identify S3 objects that can be cleaned up as abandoned
/// drafts.
model DraftUpload {
  id             String    @id @default(cuid())
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider       String
  bucket         String
  storageKey     String    @unique
  contentType    String
  byteSize       Int
  checksumSha256 String
  purpose        String
  expiresAt      DateTime
  claimedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, purpose, claimedAt, expiresAt])
  @@index([claimedAt, expiresAt])
  @@index([purpose, expiresAt])
}

/// Photo attached to one person document slot.
///
/// A partial unique index allows exactly one active image per document and
/// slot while preserving replaced/deleted history.
model PersonDocumentPhoto {
  id               String         @id @default(cuid())
  personDocumentId String
  personDocument   PersonDocument @relation(fields: [personDocumentId], references: [id], onDelete: Cascade)
  assetId          String         @unique
  asset            MediaAsset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  slot             String
  createdAt        DateTime       @default(now())
  deletedAt        DateTime?

  @@unique([personDocumentId, slot], map: "person_document_photo_active_slot_unique", where: { deletedAt: null })
  @@index([personDocumentId, deletedAt])
  @@index([slot])
}

/// Scooter brand/manufacturer catalog. `code` is a short curated identifier
/// (not derived automatically) used as part of the printed fleet sticker.
model ScooterBrand {
  id        String    @id @default(cuid())
  name      String    @unique
  code      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  scooters  Scooter[]
}

/// Scooter inventory record with Romanian registration metadata.
model Scooter {
  id                        String              @id @default(cuid())
  vin                       String              @unique
  brandId                   String
  brand                     ScooterBrand        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  model                     String
  color                     String?
  manufactureYear           Int
  powertrainType            String
  engineType                String?
  engineCc                  Int?
  powerKw                   Float?
  registrationType          String              @default("unregistered")
  plateNumber               String?
  plateNumberNormalized     String?
  registeredOn              DateTime?           @db.Date
  registrationExpiresOn     DateTime?           @db.Date
  requiredDriverLicenseType String              @default("none")
  /// Enforced as non-negative by the maintenance migration CHECK constraint.
  currentMileageKm          Int?
  notes                     String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  deletedAt                 DateTime?
  issues                    ScooterIssue[]
  maintenanceRecords        MaintenanceRecord[]

  @@unique([plateNumberNormalized], map: "Scooter_active_plateNumberNormalized_key", where: raw("\"deletedAt\" IS NULL AND \"plateNumberNormalized\" IS NOT NULL"))
  @@index([deletedAt])
  @@index([powertrainType, deletedAt])
  @@index([registrationType, deletedAt])
  @@index([requiredDriverLicenseType, deletedAt])
  @@index([brandId, model])
}

/// A reported fleet issue. Resolution intentionally stays lightweight for the
/// MVP: FIXED issues record their resolution time without a separate workflow.
model ScooterIssue {
  id               String               @id @default(cuid())
  scooterId        String
  scooter          Scooter              @relation(fields: [scooterId], references: [id], onDelete: Restrict)
  title            String
  description      String?
  severity         ScooterIssueSeverity
  status           ScooterIssueStatus   @default(OPEN)
  reportedAt       DateTime             @default(now())
  resolvedAt       DateTime?
  reportedByUserId String?
  reportedBy       User?                @relation("ScooterIssueReportedBy", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([scooterId, status, severity(sort: Desc), reportedAt(sort: Desc)])
  @@index([status, reportedAt(sort: Desc)])
  @@index([severity, reportedAt(sort: Desc)])
  @@index([reportedAt(sort: Desc)])
  @@index([reportedByUserId])
}

/// Admin-editable service definition. Seeded intervals are conservative
/// examples only; the applicable manufacturer schedule remains authoritative.
model MaintenanceType {
  id             String              @id @default(cuid())
  name           String
  code           String              @unique
  /// Positive when set; enforced by a database CHECK constraint.
  intervalKm     Int?
  /// Positive when set; enforced by a database CHECK constraint.
  intervalMonths Int?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  records        MaintenanceRecord[]

  @@index([isActive, name])
}

/// One completed service item for one scooter. A service visit that performs
/// multiple items creates one record per MaintenanceType.
model MaintenanceRecord {
  id                String          @id @default(cuid())
  scooterId         String
  scooter           Scooter         @relation(fields: [scooterId], references: [id], onDelete: Restrict)
  maintenanceTypeId String
  maintenanceType   MaintenanceType @relation(fields: [maintenanceTypeId], references: [id], onDelete: Restrict)
  performedAt       DateTime        @db.Date
  /// Enforced as non-negative by the maintenance migration CHECK constraint.
  performedKm       Int
  notes             String?
  /// Enforced as non-negative when set by a database CHECK constraint.
  nextDueKm         Int?
  nextDueAt         DateTime?       @db.Date
  recordedByUserId  String?
  recordedBy        User?           @relation("MaintenanceRecordRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([scooterId, maintenanceTypeId, performedAt(sort: Desc), createdAt(sort: Desc)])
  @@index([scooterId, performedAt(sort: Desc), createdAt(sort: Desc)])
  @@index([maintenanceTypeId, performedAt(sort: Desc)])
  @@index([nextDueAt])
  @@index([recordedByUserId])
}

/// First-class session record. One row per "logged-in device". Refresh-token
/// rotations within the same session reuse this row (only `lastUsedAt`
/// moves). Powers the user-visible "active devices" list and "log out other
/// devices" UI.
model Session {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent     String?
  ip            String?
  createdAt     DateTime       @default(now())
  lastUsedAt    DateTime       @default(now())
  revokedAt     DateTime?
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
}

/// One row per refresh-token *value* ever minted. Multiple rows per session
/// (one per rotation). The cleanup cron deletes rows older than `expiresAt`.
///
/// - `tokenHash` is the SHA-256 HMAC of the plaintext token (peppered by
///   REFRESH_TOKEN_HMAC_SECRET). Stored, not the plaintext.
/// - `previousJti` chains a row to the row it replaced. Lets concurrent
///   refreshes within the grace window detect they're racing against an
///   already-rotated token without rejecting either caller.
/// - `pendingTokenHash` is reserved for a possible future literal
///   idempotency design. The current chain algorithm does not use it.
/// - `revokedAt` is set on rotation, on logout, and on full-session burn
///   (reuse detection).
model RefreshToken {
  id               String    @id @default(cuid())
  jti              String    @unique
  previousJti      String?   @unique
  pendingTokenHash String?
  sessionId        String
  session          Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([sessionId, revokedAt])
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

/// One active proof per logical target. `activeKey` is cleared when the
/// challenge is consumed or superseded, allowing historical rows to remain
/// without blocking a new issuance.
///
/// The plaintext code is derived from this UUID and OTP_HMAC_SECRET, then only
/// its HMAC is persisted. Resends therefore deliver the same code without
/// storing recoverable plaintext.
model OtpChallenge {
  id            String    @id @default(uuid()) @db.Uuid
  activeKey     String?   @unique
  /// Currently "EMAIL"; reserved for future channel verification.
  channel       String
  /// "AUTH" | "OAUTH_EMAIL_VERIFY"
  purpose       String
  /// Normalized email or phone target.
  target        String
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// OAuth context is populated only for OAUTH_EMAIL_VERIFY.
  provider      String?
  providerId    String?
  firstName     String?
  lastName      String?
  codeHash      String
  expiresAt     DateTime
  usedAt        DateTime?
  attemptsCount Int       @default(0)
  sentCount     Int       @default(1)
  lastSentAt    DateTime  @default(now())
  nextSendAt    DateTime
  createdAt     DateTime  @default(now())

  @@index([channel, purpose, target, usedAt, expiresAt])
  @@index([provider, providerId, purpose, usedAt, expiresAt])
  @@index([userId])
  @@index([expiresAt])
}

/// Fixed-window counters for successful OTP delivery attempts.
///
/// `subjectHash` is an HMAC-derived target or IP identifier. No additional
/// plaintext email or IP data is stored here. Rows are independent of
/// challenges so limits survive challenge expiry, API restarts, and
/// multi-instance deployments.
model OtpDeliveryQuota {
  /// "TARGET_HOUR" | "TARGET_DAY" | "IP_HOUR"
  bucket      String
  subjectHash String
  windowStart DateTime
  windowEnd   DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([bucket, subjectHash, windowStart])
  @@index([windowEnd])
}

/// One row per OAuth identity linked to a user. The `provider + providerId`
/// uniqueness prevents the same provider account from binding to two users.
///
/// `email` is captured opportunistically at link time for support and audit
/// context. Repeat logins resolve through the stable provider subject, so
/// providers may omit the email claim after the initial link.
model AuthAccount {
  id         String   @id @default(cuid())
  /// "google" | "apple"
  provider   String
  providerId String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String?
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
  @@index([userId])
}

/// Append-only audit log. Account deactivation preserves both the row and its
/// User relation so forensics + compliance reports retain their actor context.
///
/// `type` values are defined in TS by `AuditEventType` and include:
/// SIGNUP, LOGIN_SUCCESS, LOGIN_FAIL, EMAIL_VERIFIED, OAUTH_LINKED,
/// OAUTH_UNLINKED, SESSION_REVOKED, SESSION_BURNED, LOGOUT_ALL,
/// ACCOUNT_DELETED, NEW_DEVICE_NOTIFIED.
model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type       String
  targetType String?
  targetId   String?
  ip         String?
  userAgent  String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([userId, type, createdAt])
  @@index([type, createdAt])
  @@index([targetType, targetId, createdAt])
}

// ---------------------------------------------------------------------------
// Financial module
//
// Design reference: docs/finance/financial-system-architecture.md
//
// Two conceptual books (COMPANY, ASSOCIATE_POOL) over one double-entry
// ledger. `FinanceBook` is NOT multi-tenancy — ScooterCity is a single
// company. A `User` acting inside a book is called an "associate".
//
// Invariants that PostgreSQL enforces live in the migration SQL
// (20260815xxxxxx_add_financial_module). Application code validates the same
// rules first so users get readable errors; the database is the last line.
// ---------------------------------------------------------------------------

enum FinanceBookType {
  COMPANY
  ASSOCIATE_POOL
}

enum FinancialOperationKind {
  EXPENSE
  INCOME
  TRANSFER
  ASSOCIATE_FUNDING
  REIMBURSEMENT
  PERSONAL_USE
  REVERSAL
}

enum FinancialOperationStatus {
  DRAFT
  POSTED
  REVERSED
}

enum LedgerAccountCategory {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerAccountRole {
  BANK
  CASH_REGISTER

  COMPANY_CASH_CUSTODY
  ASSOCIATE_POOL_CASH_CUSTODY

  PAYABLE_TO_ASSOCIATE
  RECEIVABLE_FROM_ASSOCIATE
  ASSOCIATE_LOAN_PAYABLE
  CONTRIBUTED_CAPITAL

  OPERATING_EXPENSE
  NON_OPERATIONAL_COMPANY_EXPENSE
  ASSOCIATE_POOL_EXPENSE

  FIXED_ASSET

  RENTAL_REVENUE
  SCOOTER_SALE_REVENUE
  ASSOCIATE_POOL_REVENUE
}

enum ExpenseTreatment {
  OPERATING_EXPENSE
  NON_OPERATIONAL_COMPANY_EXPENSE
  CAPITAL_ASSET
  ASSOCIATE_POOL_EXPENSE
}

enum ExpensePaymentSourceType {
  BOOK_ACCOUNT
  ASSOCIATE_PERSONAL_FUNDS
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  OTHER
}

enum EconomicAllocationType {
  COMMON
  ASSOCIATE_SPECIFIC
}

enum IncomeType {
  RENTAL
  SCOOTER_SALE
}

enum AssociateFundingType {
  LOAN
  CAPITAL_CONTRIBUTION
}

enum ReimbursementType {
  EXPENSE_ADVANCE_REPAYMENT
  ASSOCIATE_LOAN_REPAYMENT
  ASSOCIATE_RECEIVABLE_REPAYMENT
}

enum CostObjectType {
  SCOOTER
  VEHICLE
  PROPERTY
  OFFICE
  FLEET
  EQUIPMENT
  OTHER
}

enum CostObjectOwnershipType {
  COMPANY
  ASSOCIATE
  SHARED
  EXTERNAL
}

enum FinancialDocumentType {
  RECEIPT
  INVOICE
  CONTRACT
  OTHER
}

enum SettlementRunKind {
  COMPANY_SPECIFIC_BENEFIT
  ASSOCIATE_POOL_CASH
}

enum SettlementRunStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_SETTLED
  SETTLED
  CANCELLED
}

enum SettlementTransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

/// One of the two financial books. Exactly one row per `FinanceBookType`.
model FinanceBook {
  id                 String               @id @default(cuid())
  name               String
  type               FinanceBookType      @unique
  functionalCurrency String               @default("RON")
  members            FinanceBookMember[]
  accounts           LedgerAccount[]
  operations         FinancialOperation[]
  expenseCategories  ExpenseCategory[]
  costObjects        CostObject[]
  settlementRuns     SettlementRun[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

/// An associate's ownership share of one book, valid over a time range.
/// Active shares must total exactly 10,000 basis points.
model FinanceBookMember {
  id               String      @id @default(cuid())
  bookId           String
  associateId      String
  /// 5000 means 50.00%.
  shareBasisPoints Int
  validFrom        DateTime    @default(now())
  validUntil       DateTime?
  book             FinanceBook @relation(fields: [bookId], references: [id], onDelete: Restrict)
  associate        User        @relation("FinanceBookMemberAssociate", fields: [associateId], references: [id], onDelete: Restrict)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([bookId, validFrom, validUntil])
  @@index([associateId])
}

/// A ledger account. `role` carries the accounting meaning; `category`
/// determines posting sign. The role/category pairing is validated in
/// application code (see finance §6) and by a database CHECK constraint.
model LedgerAccount {
  id                        String                @id @default(cuid())
  bookId                    String
  code                      String
  name                      String
  category                  LedgerAccountCategory
  role                      LedgerAccountRole
  /// Set on accounts tied to one associate: company/pool cash custody,
  /// payable, receivable, and loan payable. Never a personal wealth account.
  associateId               String?
  isDefault                 Boolean               @default(false)
  isActive                  Boolean               @default(true)
  isSystem                  Boolean               @default(false)
  book                      FinanceBook           @relation(fields: [bookId], references: [id], onDelete: Restrict)
  associate                 User?                 @relation("LedgerAccountAssociate", fields: [associateId], references: [id], onDelete: Restrict)
  postings                  JournalPosting[]
  expensePaymentSources     ExpensePayment[]      @relation("ExpensePaymentSourceAccount")
  incomeDestinations        Income[]              @relation("IncomeDestinationAccount")
  transfersFrom             MoneyTransfer[]       @relation("TransferFromAccount")
  transfersTo               MoneyTransfer[]       @relation("TransferToAccount")
  fundingDestinations       AssociateFunding[]    @relation("FundingDestinationAccount")
  reimbursementCashAccounts Reimbursement[]       @relation("ReimbursementCashAccount")
  reimbursementObligations  Reimbursement[]       @relation("ReimbursementObligationAccount")
  personalUseSources        PersonalUse[]         @relation("PersonalUseSourceAccount")
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  @@unique([bookId, code])
  @@index([bookId, role])
  @@index([bookId, associateId])
}

/// The business operation. Answers "what happened". The kind-specific detail
/// lives in exactly one of the optional detail relations below.
model FinancialOperation {
  id                    String                   @id @default(cuid())
  bookId                String
  kind                  FinancialOperationKind
  status                FinancialOperationStatus @default(DRAFT)
  occurredAt            DateTime
  description           String?
  /// Identifies the client command/request, not the database record.
  idempotencyKey        String
  createdById           String
  postedAt              DateTime?
  /// Present only on a REVERSAL operation.
  reversalOfOperationId String?                  @unique
  book                  FinanceBook              @relation(fields: [bookId], references: [id], onDelete: Restrict)
  createdBy             User                     @relation("FinancialOperationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reversalOf            FinancialOperation?      @relation("FinancialOperationReversal", fields: [reversalOfOperationId], references: [id], onDelete: Restrict)
  reversedBy            FinancialOperation?      @relation("FinancialOperationReversal")
  expense               Expense?
  income                Income?
  transfer              MoneyTransfer?
  associateFunding      AssociateFunding?
  reimbursement         Reimbursement?
  personalUse           PersonalUse?
  allocations           EconomicAllocation[]
  documents             FinancialDocument[]
  journalEntry          JournalEntry?
  settlementRuns        SettlementOperation[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@unique([bookId, idempotencyKey])
  @@index([bookId, occurredAt])
  @@index([bookId, kind, status])
  @@index([status])
}

/// Admin-managed expense taxonomy. `defaultTreatment` is a UI convenience;
/// the persisted expense always carries an explicit treatment.
model ExpenseCategory {
  id               String            @id @default(cuid())
  bookId           String
  code             String
  name             String
  defaultTreatment ExpenseTreatment?
  isActive         Boolean           @default(true)
  book             FinanceBook       @relation(fields: [bookId], references: [id], onDelete: Restrict)
  expenses         Expense[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([bookId, code])
  @@index([bookId, isActive])
}

/// What object, vehicle, property, or activity a cost belonged to.
/// Its defaults prefill the expense form; they never drive posting logic.
model CostObject {
  id                            String                  @id @default(cuid())
  bookId                        String
  code                          String
  name                          String
  type                          CostObjectType
  ownershipType                 CostObjectOwnershipType
  /// Required when ownershipType = ASSOCIATE.
  ownerAssociateId              String?
  /// Optional soft link to an existing domain entity, e.g. "SCOOTER" + id.
  externalEntityType            String?
  externalEntityId              String?
  /// UI defaults only. Every expense still persists explicit allocations.
  defaultAllocationType         EconomicAllocationType?
  defaultBeneficiaryAssociateId String?
  isActive                      Boolean                 @default(true)
  book                          FinanceBook             @relation(fields: [bookId], references: [id], onDelete: Restrict)
  ownerAssociate                User?                   @relation("CostObjectOwner", fields: [ownerAssociateId], references: [id], onDelete: Restrict)
  defaultBeneficiaryAssociate   User?                   @relation("CostObjectDefaultBeneficiary", fields: [defaultBeneficiaryAssociateId], references: [id], onDelete: Restrict)
  expenses                      Expense[]
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt

  @@unique([bookId, code])
  @@index([bookId, type])
  @@index([ownerAssociateId])
  @@index([externalEntityType, externalEntityId])
}

/// Expense detail for a `FinancialOperation` of kind EXPENSE. Every row here
/// is a legitimate book expense by definition; strictly personal purchases
/// are `PersonalUse` instead.
model Expense {
  id           String             @id @default(cuid())
  operationId  String             @unique
  amountMinor  Int
  treatment    ExpenseTreatment
  categoryId   String
  costObjectId String?
  operation    FinancialOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  category     ExpenseCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  costObject   CostObject?        @relation(fields: [costObjectId], references: [id], onDelete: Restrict)
  payments     ExpensePayment[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([categoryId])
  @@index([costObjectId])
  @@index([treatment])
}

/// Who paid, and from where. `ASSOCIATE_PERSONAL_FUNDS` records that the
/// associate advanced their own money — `paymentMethod` is metadata, not a
/// personal ledger account. Payments never imply who benefited.
model ExpensePayment {
  id               String                   @id @default(cuid())
  expenseId        String
  sourceType       ExpensePaymentSourceType
  amountMinor      Int
  paymentMethod    PaymentMethod
  /// Required when sourceType = BOOK_ACCOUNT.
  sourceAccountId  String?
  /// Required when sourceType = ASSOCIATE_PERSONAL_FUNDS.
  payerAssociateId String?
  expense          Expense                  @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  sourceAccount    LedgerAccount?           @relation("ExpensePaymentSourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  payerAssociate   User?                    @relation("ExpensePaymentPayer", fields: [payerAssociateId], references: [id], onDelete: Restrict)
  createdAt        DateTime                 @default(now())

  @@index([expenseId])
  @@index([payerAssociateId])
  @@index([sourceAccountId])
}

/// Who received the economic benefit. Independent of who paid.
/// COMMON lines never create associate settlement; ASSOCIATE_SPECIFIC do.
model EconomicAllocation {
  id          String                 @id @default(cuid())
  operationId String
  type        EconomicAllocationType
  amountMinor Int
  /// Required only when type = ASSOCIATE_SPECIFIC.
  associateId String?
  operation   FinancialOperation     @relation(fields: [operationId], references: [id], onDelete: Restrict)
  associate   User?                  @relation("EconomicAllocationAssociate", fields: [associateId], references: [id], onDelete: Restrict)
  createdAt   DateTime               @default(now())

  @@index([operationId])
  @@index([associateId])
}

/// Supporting paperwork. Metadata only — a document never determines which
/// book owns an operation.
model FinancialDocument {
  id             String                @id @default(cuid())
  operationId    String
  type           FinancialDocumentType
  documentNumber String?
  issuedAt       DateTime?
  supplierName   String?
  supplierTaxId  String?
  storageKey     String?
  notes          String?
  operation      FinancialOperation    @relation(fields: [operationId], references: [id], onDelete: Restrict)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([operationId])
}

/// Income detail for a `FinancialOperation` of kind INCOME.
model Income {
  id                   String             @id @default(cuid())
  operationId          String             @unique
  type                 IncomeType
  amountMinor          Int
  paymentMethod        PaymentMethod
  destinationAccountId String
  /// Soft links to existing domain rows; kept nullable while rentals are
  /// not yet modelled in this schema.
  rentalId             String?
  scooterId            String?
  operation            FinancialOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  destinationAccount   LedgerAccount      @relation("IncomeDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([destinationAccountId])
  @@index([rentalId])
  @@index([scooterId])
}

/// Movement between two asset accounts of the same book. Never touches
/// revenue, expense, profit, or settlement.
model MoneyTransfer {
  id            String             @id @default(cuid())
  operationId   String             @unique
  amountMinor   Int
  fromAccountId String
  toAccountId   String
  operation     FinancialOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  fromAccount   LedgerAccount      @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount     LedgerAccount      @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  createdAt     DateTime           @default(now())

  @@index([fromAccountId])
  @@index([toAccountId])
}

/// An associate lending money to the book. Debt, never revenue.
model AssociateFunding {
  id                   String               @id @default(cuid())
  operationId          String               @unique
  type                 AssociateFundingType @default(LOAN)
  associateId          String
  destinationAccountId String
  amountMinor          Int
  reference            String?
  notes                String?
  operation            FinancialOperation   @relation(fields: [operationId], references: [id], onDelete: Restrict)
  associate            User                 @relation("AssociateFundingAssociate", fields: [associateId], references: [id], onDelete: Restrict)
  destinationAccount   LedgerAccount        @relation("FundingDestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  createdAt            DateTime             @default(now())

  @@index([associateId])
  @@index([destinationAccountId])
}

/// Settling an obligation between the book and an associate. Never creates
/// an expense or revenue.
model Reimbursement {
  id                  String             @id @default(cuid())
  operationId         String             @unique
  type                ReimbursementType
  associateId         String
  amountMinor         Int
  /// Source account for liability repayment; destination for receivable
  /// repayment.
  cashAccountId       String
  /// PAYABLE_TO_ASSOCIATE, ASSOCIATE_LOAN_PAYABLE, or
  /// RECEIVABLE_FROM_ASSOCIATE.
  obligationAccountId String
  operation           FinancialOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  associate           User               @relation("ReimbursementAssociate", fields: [associateId], references: [id], onDelete: Restrict)
  cashAccount         LedgerAccount      @relation("ReimbursementCashAccount", fields: [cashAccountId], references: [id], onDelete: Restrict)
  obligationAccount   LedgerAccount      @relation("ReimbursementObligationAccount", fields: [obligationAccountId], references: [id], onDelete: Restrict)
  createdAt           DateTime           @default(now())

  @@index([associateId])
  @@index([cashAccountId])
  @@index([obligationAccountId])
}

/// Book money spent on something that does not belong to the book. Creates a
/// receivable from the associate, never an expense.
model PersonalUse {
  id              String             @id @default(cuid())
  operationId     String             @unique
  associateId     String
  sourceAccountId String
  amountMinor     Int
  operation       FinancialOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  associate       User               @relation("PersonalUseAssociate", fields: [associateId], references: [id], onDelete: Restrict)
  sourceAccount   LedgerAccount      @relation("PersonalUseSourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  createdAt       DateTime           @default(now())

  @@index([associateId])
  @@index([sourceAccountId])
}

/// The double-entry record for one posted operation. Immutable once written.
model JournalEntry {
  id          String             @id @default(cuid())
  operationId String             @unique
  postedAt    DateTime           @default(now())
  operation   FinancialOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)
  postings    JournalPosting[]
  createdAt   DateTime           @default(now())
}

/// One ledger line. Positive = debit, negative = credit; the lines of an
/// entry always sum to zero.
model JournalPosting {
  id                String        @id @default(cuid())
  journalEntryId    String
  accountId         String
  lineNumber        Int
  signedAmountMinor Int
  description       String?
  journalEntry      JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account           LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdAt         DateTime      @default(now())

  @@unique([journalEntryId, lineNumber])
  @@index([journalEntryId])
  @@index([accountId])
}

/// One settlement calculation over a period. Company-benefit settlement and
/// pool-cash settlement stay separate runs and are never netted in the ledger.
model SettlementRun {
  id             String                    @id @default(cuid())
  bookId         String
  kind           SettlementRunKind
  status         SettlementRunStatus       @default(DRAFT)
  /// Half-open period: [periodStart, periodEnd).
  periodStart    DateTime
  periodEnd      DateTime
  createdById    String
  calculatedAt   DateTime                  @default(now())
  confirmedAt    DateTime?
  completedAt    DateTime?
  book           FinanceBook               @relation(fields: [bookId], references: [id], onDelete: Restrict)
  createdBy      User                      @relation("SettlementRunCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  shareSnapshots SettlementShareSnapshot[]
  lines          SettlementLine[]
  transfers      SettlementTransfer[]
  operations     SettlementOperation[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([bookId, kind, periodStart, periodEnd])
  @@index([status])
}

/// Ownership shares frozen at calculation time, so a later share change
/// cannot rewrite a historical settlement.
model SettlementShareSnapshot {
  id               String        @id @default(cuid())
  settlementRunId  String
  associateId      String
  shareBasisPoints Int
  settlementRun    SettlementRun @relation(fields: [settlementRunId], references: [id], onDelete: Restrict)
  associate        User          @relation("SettlementShareAssociate", fields: [associateId], references: [id], onDelete: Restrict)

  @@unique([settlementRunId, associateId])
  @@index([associateId])
}

/// One associate's position in a settlement run.
model SettlementLine {
  id                  String        @id @default(cuid())
  settlementRunId     String
  associateId         String
  /// COMPANY_SPECIFIC_BENEFIT: specific benefit received.
  /// ASSOCIATE_POOL_CASH: pool cash currently held.
  actualAmountMinor   Int
  expectedAmountMinor Int
  /// Positive = associate must receive. Negative = associate must pay.
  adjustmentMinor     Int
  settlementRun       SettlementRun @relation(fields: [settlementRunId], references: [id], onDelete: Restrict)
  associate           User          @relation("SettlementLineAssociate", fields: [associateId], references: [id], onDelete: Restrict)

  @@unique([settlementRunId, associateId])
  @@index([associateId])
}

/// A private associate-to-associate payment that squares a settlement run.
/// Distinct from any company reimbursement obligation.
model SettlementTransfer {
  id              String                   @id @default(cuid())
  settlementRunId String
  fromAssociateId String
  toAssociateId   String
  amountMinor     Int
  status          SettlementTransferStatus @default(PENDING)
  paymentMethod   PaymentMethod?
  completedAt     DateTime?
  notes           String?
  settlementRun   SettlementRun            @relation(fields: [settlementRunId], references: [id], onDelete: Restrict)
  fromAssociate   User                     @relation("SettlementTransferFrom", fields: [fromAssociateId], references: [id], onDelete: Restrict)
  toAssociate     User                     @relation("SettlementTransferTo", fields: [toAssociateId], references: [id], onDelete: Restrict)

  @@index([settlementRunId])
  @@index([fromAssociateId])
  @@index([toAssociateId])
}

/// Marks an operation as already consumed by a settlement run, so a later
/// run cannot double-count it.
model SettlementOperation {
  settlementRunId String
  operationId     String             @unique
  settlementRun   SettlementRun      @relation(fields: [settlementRunId], references: [id], onDelete: Restrict)
  operation       FinancialOperation @relation(fields: [operationId], references: [id], onDelete: Restrict)

  @@id([settlementRunId, operationId])
}
