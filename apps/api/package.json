{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm --filter @repo/theme build && pnpm --filter @repo/i18n build && pnpm --filter @repo/api-shared build && prisma generate && nest build",
    "postinstall": "prisma generate",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "pnpm --filter @repo/theme build && pnpm --filter @repo/i18n build && pnpm --filter @repo/api-shared build && nest start",
    "dev": "pnpm --filter @repo/theme build && pnpm --filter @repo/i18n build && pnpm --filter @repo/api-shared build && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "spec": "node dist/src/main --spec-only",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" scripts/test-e2e.ts --max-warnings 0",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" scripts/test-e2e.ts --max-warnings 0 --fix",
    "check-types": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "access:bootstrap": "tsx scripts/access-bootstrap.ts",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "test": "pnpm --filter @repo/theme build && pnpm --filter @repo/i18n build && pnpm --filter @repo/api-shared build && NODE_OPTIONS='--experimental-vm-modules' jest --passWithNoTests --watchman=false",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node --import tsx scripts/test-e2e.ts",
    "benchmark:textract": "tsx src/document-extraction/benchmark/analyze-private-receipts.ts"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1149.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/client-textract": "^3.1115.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
    "@cantoo/pdf-lib": "2.11.1",
    "@casl/ability": "7.0.1",
    "@casl/prisma": "2.0.2",
    "@napi-rs/canvas": "1.0.10",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@repo/api-shared": "workspace:*",
    "@repo/i18n": "workspace:^",
    "@repo/theme": "workspace:*",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.6.2",
    "jose": "^6.2.3",
    "ms": "^2.1.3",
    "multer": "^2.2.0",
    "nestjs-pino": "^4.4.0",
    "nestjs-zod": "^5.3.0",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.20.0",
    "pino": "^9.5.0",
    "pino-http": "^10.4.0",
    "prisma": "^7.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "standardwebhooks": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "esbuild": "^0.27.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/../test/setup-env.ts"
    ]
  }
}
