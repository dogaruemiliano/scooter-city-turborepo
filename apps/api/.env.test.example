# Copy to .env.test. Shell/CI variables override this file.
# Dedicated disposable databases; never use the application's DATABASE_URL.
E2E_DATABASE_URL=postgresql://app:app@localhost:55434/scooter_city_test
# Connection template: each finance run creates and removes a fresh database
# named finance_books_test_<random suffix> on this server. Requires CREATEDB.
E2E_FINANCE_DATABASE_URL=postgresql://app:app@localhost:55434/finance_books_test
