{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyScooterValidationAndCleanupPrefixes",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions"],
      "Resource": "arn:aws:s3:::scooter-city-s3-private-bucket-dev",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "dev-api/scooter-documents/*",
            "dev-api/extraction-temporary/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadAndCleanTrackedScooterVersions",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::scooter-city-s3-private-bucket-dev/dev-api/scooter-documents/*",
        "arn:aws:s3:::scooter-city-s3-private-bucket-dev/dev-api/extraction-temporary/*"
      ]
    },
    {
      "Sid": "WriteDevelopmentValidationSnapshots",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::scooter-city-s3-private-bucket-dev/dev-api/extraction-temporary/*"
    }
  ]
}
