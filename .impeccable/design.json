  "narrative": {
    "northStar": "The Fleet Console",
    "overview": "A compact workspace for fleet and company operations, grounded in the approved UX Pilot Scooter City App visuals. Manrope, neutral surfaces, inset controls, and clear cyan actions make detailed forms easy to scan. Evidence, recorded status, and validation stay legible alongside the task.\n\nThis records the built shared system. [Theme tokens](packages/theme/src/tokens/) remain the source of truth; frontmatter and the [preview sidecar](.impeccable/design.json) reference their current CSS variables. For standalone previews, the sidecar resolves utility-only values pruned by Tailwind from the generated theme. Extend tokens first, then shared [UI components](packages/ui/src/components/), then a feature. The product's operating constraints live in [PRODUCT.md](PRODUCT.md).",
    "keyCharacteristics": [
      "Compact, practical typography with clear field and section hierarchy.",
      "Near-black dark pages, neutral panels, and black inset controls.",
      "Cyan primary actions and active navigation with dark foregrounds.",
      "Rounded panels, restrained borders, and a subtle cyan action shadow.",
      "Complete light and dark semantic surfaces."
    ],
    "rules": [
      {
        "name": "The Surface Rule",
        "body": "Sheets use the popover surface and foreground continuously through header, body, and footer; nested content must not cover the sheet with the page background.",
        "section": "colors"
      },
      {
        "name": "The Foreground Pair Rule",
        "body": "Keep semantic surface/foreground pairs together, especially cyan actions and media scrims.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do add missing visual values to the canonical theme before using them.",
      "Do reuse shared components and semantic surface/foreground pairs.",
      "Do verify light/dark contrast, keyboard focus, and English/Romanian wrapping.",
      "Do show real recorded state and explicit review, loading, error, and disabled feedback.",
      "Do keep document evidence inspectable beside or above its review fields."
    ],
    "donts": [
      "Don't introduce page-local palettes, radii, spacing, or motion values.",
      "Don't use the page background across a sheet or its full-width children.",
      "Don't put white text on the cyan primary fill or reuse that fill as a small text color.",
      "Don't invent fleet status or replace document evidence with decorative imagery."
    ]
  }
